# E-PESANTREN 360 — Investor Demo
# Copy this file to .env on the server.

NODE_ENV=production
PORT=3000

# Optional: used only if AI features are enabled.
GEMINI_API_KEY=

# Public URL of the deployed application.
APP_URL=https://YOUR-DOMAIN-OR-SERVER-URL

# IMPORTANT:
# Current investor-demo authentication uses server-side in-memory sessions.
# The current source does not contain Prisma/PostgreSQL.
